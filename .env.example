# Anthropic API key. Required only for the LLM steps (strategist, copywriter).
# The app starts, the fixture loads, and the policy engine runs without it.
ANTHROPIC_API_KEY=

# Model IDs are configurable so tiers can change without touching pipeline code.
STRATEGIST_MODEL=claude-sonnet-5
COPYWRITER_MODEL=claude-haiku-4-5-20251001

# Where JSON state lives (evaluations, run log, review actions). Defaults to ./data.
# DATA_DIR=./data
